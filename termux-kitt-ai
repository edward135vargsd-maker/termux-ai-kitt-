name: Build Termux-AI K.I.T.T. APK

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    
    steps:
    - name: 1. Checkout Termux repo
      uses: actions/checkout@v4

    - name: 2. Setup JDK 17
      uses: actions/setup-java@v5
      with:
        distribution: 'temurin'
        java-version: '17'

    - name: 3. Setup Android SDK
      uses: android-actions/setup-android@v3
      with:
        packages: 'platforms;android-33 build-tools;33.0.2 ndk;25.2.9519653'

    - name: 4. Download and integrate llama.cpp
      run: |
        cd terminal-emulator/src/main/cpp || cd app/src/main/cpp
        git clone https://github.com/ggerganov/llama.cpp.git

    - name: 5. Build APK with Gradle
      run: |
        chmod +x ./gradlew
        ./gradlew assembleRelease --no-daemon

    - name: 6. Upload APK Artifact
      uses: actions/upload-artifact@v4
      with:
        name: Termux-AI-KITT-Release
        path: app/build/outputs/apk/release/*.apk
